# ---- Aplicación ----
APP_NAME=FastAPI Demo API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info

# ---- API ----
# Prefijo de todos los endpoints de negocio (ej. /api/v1/items)
API_PREFIX=/api/v1
# Orígenes permitidos por CORS separados por comas ("*" permite todos)
CORS_ORIGINS=*
# Carga 3 items de ejemplo al iniciar (true/false)
SEED_DEMO_DATA=true

# ---- PostgreSQL ----
# La URL usada por la API. En Compose, el host de la base de datos es "db".
DATABASE_URL=postgresql://app:app@db:5432/itemsdb
POSTGRES_DB=itemsdb
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# ---- Docker / Docker Compose ----
# Puerto del host que se publica hacia el puerto 8000 del contenedor
APP_PORT=8000
